# Reference only: set these in your shell or Render environment settings.
# The application does not automatically load this file.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_API_KEY
CLOUDINARY_API_SECRET=YOUR_API_SECRET
HTTPS=0
# Optional: business scheduling timezone. Defaults to Buenos Aires.
BUSINESS_TIMEZONE=America/Argentina/Buenos_Aires
